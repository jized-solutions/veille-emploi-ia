# Copier ce fichier sous le nom .env, puis remplacer les valeurs.
# Ne jamais transmettre ni versionner le fichier .env réel.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre

# Clé créée sur le portail développeur TomTom.
TOMTOM_API_KEY=

# Origine routière par défaut : centre de Baillargues.
# Valeurs facultatives, modifiables localement si un autre point de départ est retenu.
TRAVEL_ORIGIN_LABEL=Baillargues centre
TRAVEL_ORIGIN_LATITUDE=43.660593
TRAVEL_ORIGIN_LONGITUDE=4.013409
